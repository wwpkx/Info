{
    "workbench.editorAssociations": {
        // "*.md": "vscode.markdown.preview.editor"        
        // "*.md": "markmap-vscode.markmap"
    },
    "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:：'\",.<>/?，“”（）【】「」？！",
    "files.autoGuessEncoding": true,
    "files.candidateGuessEncodings": [
        "utf8",
        "gb2312"
    ],
    "markdown.copyFiles.destination": {
        "**/*.md": "../../photo/${fileName}"
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    }
}